---
import Shell from "@/layouts/Shell.astro";
import BreadcrumbSchema from "@/components/seo/BreadcrumbSchema.astro";
import { getCollection } from "astro:content";
import { live } from "@/utils/archive";
import { fmtDate } from "@/utils/feed";

const projects = live(await getCollection("projects"))
  .sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);
---
<Shell title="Projects | Siddhant Shah"
  description="Things I've built and measured — lap times, query engines, fertility data."
  canonical="/projects/">
  <BreadcrumbSchema slot="head" items={[{ name: "Home", url: "/" }, { name: "Projects" }]} />
  <div class="page">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Projects</p>
      <h1 class="h1">Things I built.</h1>
      <p class="lede">Mostly to answer a question I couldn't look up.</p>
      <ul class="feed">
        {projects.map((p) => (
          <li>
            <a class="row" href={`/projects/${p.id.replace(/\.(md|mdx)$/, "").toLowerCase()}/`}>
              <span class="m">
                <span>{fmtDate(p.data.publishedAt)}</span>
                {p.data.isOngoing && <span>ongoing</span>}
              </span>
              <span class="t">{p.data.title}</span>
              <span class="d">{p.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Shell>

---
// KaTeX styles are bundled from the same version rehype-katex renders with.
// The jsdelivr stylesheet was a render-blocking third-party request, and it
// was pinned to 0.15.2 while the markup came from 0.16.
import "katex/dist/katex.min.css";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Shell from "@/layouts/Shell.astro";
import Article from "@/components/Article.astro";
import { seoTitle } from "@/utils/seoTitle";
import BreadcrumbSchema from "@/components/seo/BreadcrumbSchema.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { entry: project },
  }));
}

type Props = {
  entry: CollectionEntry<"projects">;
};

const { entry } = Astro.props;
const { Content } = await entry.render();
---
<Shell
  title={seoTitle(entry.data.title)}
  description={entry.data.description}
  canonical={`/projects/${entry.slug}/`}
  og={{
    title: entry.data.title,
    type: "article",
    description: entry.data.description,
  }}
>

  <BreadcrumbSchema
    slot="head"
    items={[
      { name: "Home", url: "/" },
      { name: "Projects", url: "/projects/" },
      { name: entry.data.title }
    ]}
  />

  <Article type="project" entry={entry} Content={Content} />
</Shell>

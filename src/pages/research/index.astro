---
import Shell from "@/layouts/Shell.astro";
import { getCollection } from "astro:content";
import { live } from "@/utils/archive";
import { fmtDate } from "@/utils/feed";

const research = live(await getCollection("research"))
  .filter((r) => r.data.isPublished)
  .sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);
---
<Shell title="Research | Siddhant Shah"
  description="Peer-reviewed research on trading strategies, statistical methods and mathematical modelling."
  canonical="/research/">
  <div class="page">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Research</p>
      <h1 class="h1">Published work.</h1>
      <p class="lede">Peer-reviewed papers, from momentum in crude oil to the volume of Greek vases.</p>
      <ul class="feed">
        {research.map((r) => (
          <li>
            <a class="row" href={`/research/${r.id.replace(/\.(md|mdx)$/, "").toLowerCase()}/`}>
              <span class="m">
                <span>{fmtDate(r.data.publishedAt)}</span>
                {r.data.publication && <span>{r.data.publication}</span>}
              </span>
              <span class="t">{r.data.title}</span>
              <span class="d">{r.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Shell>

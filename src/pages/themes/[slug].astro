---
import Shell from "@/layouts/Shell.astro";
import { THEMES, AREAS } from "@/data/themes";
import { allPieces } from "@/utils/allPieces";
import { countThemes } from "@/utils/themeIndex";

export async function getStaticPaths() {
  const pieces = await allPieces();
  return Object.entries(THEMES).map(([slug, t]) => {
    const used = pieces
      .map((p) => ({ ...p, n: countThemes(p.entry.body).get(slug) ?? 0 }))
      .filter((p) => p.n > 0)
      .sort((a, b) => +b.entry.data.publishedAt - +a.entry.data.publishedAt);
    return { params: { slug }, props: { slug, theme: t, used } };
  });
}
const { slug, theme, used } = Astro.props;
const area = AREAS[theme.area];
const rgb = area.rgb.join(",");
const href = (p: any) =>
  `/${p.kind === "blog" ? "blog" : p.kind}/${p.entry.id.replace(/\.(md|mdx)$/, "").toLowerCase()}/`;
---
<Shell title={`${theme.label} | Siddhant Shah`}
  description={`Everything I've written on ${theme.label}.`}
  canonical={`/themes/${slug}/`}>
  <section class="band">
    <p class="eyebrow" style={`color:rgb(${rgb})`}>{area.label}</p>
    <h1 style={`color:rgb(${rgb})`}>{theme.label}</h1>
    <p class="lede">
      {used.length === 0
        ? "Nothing tagged with this yet."
        : `${used.length} piece${used.length === 1 ? "" : "s"}, most recent first.`}
    </p>
    <ul class="posts">
      {used.map((p) => (
        <li>
          <a href={href(p)}>
            <span class="pt">{p.entry.data.title}</span>
            <span class="pd">{p.entry.data.description}</span>
            <span class="pm">{p.kind} · mentioned {p.n}×</span>
          </a>
        </li>
      ))}
    </ul>
    <p><a class="ln" href="/#what">← All themes</a></p>
  </section>
</Shell>

<style>
  .band{max-width:1060px;margin:0 auto;padding:calc(var(--hdr-h) + clamp(50px,8vw,100px)) clamp(18px,6vw,80px) 0}
  .eyebrow{font-family:var(--sans);font-size:11.5px;letter-spacing:.22em;text-transform:uppercase;margin:0 0 14px;font-weight:500}
  h1{font-size:clamp(38px,7vw,72px);line-height:1;margin:0 0 18px}
  .lede{color:var(--text-2);margin:0 0 40px}
  .posts{list-style:none;margin:0 0 34px;padding:0;border-top:1px solid var(--rule)}
  .posts li{border-bottom:1px solid var(--rule)}
  .posts a{display:grid;gap:5px;padding:24px 0;text-decoration:none;transition:padding-left .4s cubic-bezier(.2,.7,.3,1)}
  .posts a:hover{padding-left:14px}
  .pt{font-size:clamp(19px,2.1vw,25px);color:var(--text);line-height:1.24}
  .pd{font-family:var(--sans);font-size:14px;color:var(--text-3);max-width:74ch;line-height:1.55}
  .pm{font-family:var(--sans);font-size:11.5px;color:var(--text-3);letter-spacing:.06em;text-transform:uppercase}
  .ln{font-family:var(--sans);font-size:14.5px;text-decoration:none;color:var(--glow);border-bottom:1px solid rgba(62,212,224,.28)}
</style>

---
// KaTeX styles are bundled from the same version rehype-katex renders with.
// The jsdelivr stylesheet was a render-blocking third-party request, and it
// was pinned to 0.15.2 while the markup came from 0.16.
import "katex/dist/katex.min.css";
import { getCollection } from 'astro:content';
import Shell from '@/layouts/Shell.astro';
import Article from '@/components/Article.astro';
import ArticleSchema from '@/components/seo/ArticleSchema.astro';
import BreadcrumbSchema from '@/components/seo/BreadcrumbSchema.astro';
import { seoTitle } from '@/utils/seoTitle';
import { estimateReadingTime } from '@/utils/estimateReadingTime';
import { themesFor } from '@/utils/themeIndex';
import { THEMES, displayLabel } from '@/data/themes';

export async function getStaticPaths() {
  const toSlug = (id: string) => id.replace(/\.(md|mdx)$/, '').toLowerCase();
  const allPosts = await getCollection('blog');

  // Series membership comes from the shared `series` frontmatter field, not from
  // the slug prefix. The prefix approach broke silently when the home post was
  // renamed 202602 -> 202603 while its parts stayed in the 202602/ folder: the
  // home stopped being recognised as a home and every part lost its parent.
  const partsOf = new Map<string, typeof allPosts>();
  for (const a of allPosts) {
    const name = a.data.series;
    if (!name || a.data.articleNumber == null) continue;
    if (!partsOf.has(name)) partsOf.set(name, []);
    partsOf.get(name)!.push(a);
  }
  for (const list of partsOf.values()) {
    list.sort((x, y) => (x.data.articleNumber ?? 0) - (y.data.articleNumber ?? 0));
  }
  // the home is the piece that names the series but is not itself numbered
  const homeOf = new Map<string, (typeof allPosts)[number]>();
  for (const a of allPosts) {
    if (a.data.series && a.data.articleNumber == null) homeOf.set(a.data.series, a);
  }

  return allPosts.map(p => {
    const seriesName = p.data.series;
    const siblings = seriesName ? partsOf.get(seriesName) : undefined;
    const home = seriesName ? homeOf.get(seriesName) : undefined;
    const isPart = Boolean(seriesName && p.data.articleNumber != null);

    const seriesArticles = siblings && siblings.length > 0 ? siblings : undefined;
    const parentSeries = isPart && home && home.id !== p.id ? home : undefined;

    let prevArticle = undefined;
    let nextArticle = undefined;
    if (isPart && siblings) {
      const idx = siblings.findIndex(a => a.id === p.id);
      prevArticle = idx > 0 ? siblings[idx - 1] : undefined;
      nextArticle = idx >= 0 && idx < siblings.length - 1 ? siblings[idx + 1] : undefined;
    }

    return {
      params: { slug: toSlug(p.id) },
      props: { entry: p, seriesArticles, parentSeries, prevArticle, nextArticle, seriesName },
    };
  });
}

const { entry, seriesArticles, parentSeries, prevArticle, nextArticle, seriesName } = Astro.props;
const stats = estimateReadingTime(entry.body);
// Keywords come from the inline theme markers, the same source the on-page chips
// use. The legacy frontmatter tags said "Crypto, Finance" on a page whose chip
// read "Derivatives" — two vocabularies describing one piece.
const keywordsFromThemes = [
  ...new Set([...themesFor(entry)].map(([s]) => THEMES[s]?.label).filter(Boolean)),
].map(displayLabel);
// A post marked isHidden is kept out of the feed and the RSS, but its page is
// still emitted so existing links keep working. It must not be advertised:
// without this it was submitted in the sitemap as index,follow.
const hidden = entry.data.isHidden === true;
const { Content } = await entry.render();

// Build SEO props from frontmatter
const entrySlug = entry.id.replace(/\.(md|mdx)$/, '').toLowerCase();
const canonicalUrl = entry.data.canonical || `/blog/${entrySlug}/`;
const ownImage = entry.data.ogImage || parentSeries?.data.ogImage;
const ogImage = ownImage || '/social-prev.png';
const headline = entry.data.seoTitle ?? entry.data.title;
---
<Shell
  noindex={hidden}
  title={seoTitle(headline)}
  description={entry.data.description}
  canonical={canonicalUrl}
  markdown={hidden ? undefined : `/blog/${entrySlug}.md`}
  og={{
    title: headline,
    type: "article",
    description: entry.data.description,
    image: ogImage,
    // the post's own figure is described by its title; the site-wide banner
    // falls back to the default alt in SEOTags
    alt: ownImage ? entry.data.title : undefined
  }}
>

  <ArticleSchema
    slot="head"
    title={entry.data.title}
    description={entry.data.description}
    publishedAt={entry.data.publishedAt}
    updatedAt={entry.data.updatedAt}
    slug={entrySlug}
    image={ogImage}
    tags={keywordsFromThemes.length ? keywordsFromThemes : entry.data.tags}
  />
  <BreadcrumbSchema
    slot="head"
    items={parentSeries ? [
      { name: "Home", url: "/" },
      { name: "Blog", url: "/blog/" },
      { name: parentSeries.data.title, url: `/blog/${parentSeries.id.replace(/\.(md|mdx)$/, '')}/` },
      { name: entry.data.title }
    ] : [
      { name: "Home", url: "/" },
      { name: "Blog", url: "/blog/" },
      { name: entry.data.title }
    ]}
  />

  <Article
    type="blog"
    entry={entry}
    Content={Content}
    seriesArticles={seriesArticles}
  seriesName={seriesName}
    parentSeries={parentSeries}
    prevArticle={prevArticle}
    nextArticle={nextArticle}
  />
</Shell>

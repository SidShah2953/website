---
import Shell from "@/layouts/Shell.astro";
---
<Shell title="Not found | Siddhant Shah"
  description="That page doesn't exist."
  canonical="/404/">
  <div class="page">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">404</p>
      <h1 class="h1">That page isn't here.</h1>
      <p class="lede">
        It may have moved, or it may never have existed. Either way, here is
        where the good stuff is.
      </p>
      <ul class="ways">
        <li><a href="/blog/"><span>Writing</span>Essays and shorter notes</a></li>
        <li><a href="/about/"><span>About</span>Who I am and what I do</a></li>
        <li><a href="/research/"><span>Research</span>Peer-reviewed papers</a></li>
        <li><a href="/projects/"><span>Projects</span>Things I built</a></li>
        <li><a href="/"><span>Home</span>Start over</a></li>
      </ul>
    </div>
  </div>
</Shell>

<style>
  .page{ padding-block: calc(var(--hdr-h) + clamp(50px,9vw,110px)) clamp(50px,9vw,120px); }
  .ways{ list-style:none;margin:0;padding:0;border-top:1px solid var(--rule); }
  .ways li{ border-bottom:1px solid var(--rule); }
  .ways a{
    display:grid;gap:4px;padding:clamp(16px,2.2vw,22px) 0;text-decoration:none;
    transition:padding-inline-start .4s cubic-bezier(.2,.7,.3,1);
  }
  .ways a:hover{ padding-inline-start:clamp(6px,1.2vw,14px); }
  .ways span{
    font-family:var(--sans);font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;
    color:var(--peacock);
  }
  .ways a{ color:var(--text);font-size:clamp(17px,2vw,21px);line-height:1.3; }
  .ways a:hover span{ color:var(--glow); }
</style>

---
import Shell from "@/layouts/Shell.astro";
import PersonSchema from "@/components/seo/PersonSchema.astro";
import WordMap from "@/components/WordMap.astro";
import Surface from "@/components/Surface.astro";
import Subscribe from "@/components/Subscribe.astro";
import { allPieces } from "@/utils/allPieces";
import { buildIndex } from "@/utils/themeIndex";
import presentation from "@/data/presentation";

const pieces = await allPieces();
const themes = buildIndex(pieces.map((p) => ({ entry: p.entry, areas: p.areas })));

const latest = pieces
  .filter((p) => p.kind === "blog")
  .sort((a, b) => +b.entry.data.publishedAt - +a.entry.data.publishedAt)
  .slice(0, 3);

const email = presentation.mail;
const desc =
  "Siddhant Shah — equity research associate. I write about finance, digital assets, technology, and whatever else I end up measuring.";
---
<Shell title="Siddhant Shah" description={desc} canonical="/" transparentHeader>
  <PersonSchema slot="head" />

  <!-- 1 · the opening -->
  <section class="hero">
    <Surface />
    <!-- scrim: guarantees copy contrast no matter where the surface flows -->
    <div class="scrim" aria-hidden="true"></div>
    <div class="hero-copy">
    <p class="kicker">Hi — I'm</p>
    <h1>Siddhant Shah</h1>
    <p class="line">
      I'm an equity research associate. I spend my days working out what
      businesses are actually worth, and my evenings <em>explaining hard things</em>
      — mostly about money, occasionally about Greek vases.
    </p>
    </div>
    <div class="scroll-cue" aria-hidden="true"><span></span></div>
  </section>

  <!-- 2 · who I am -->
  <section class="band rise">
    <h2 class="eyebrow">Who I am</h2>
    <div class="two">
      <p class="big">
        I like taking something that looks impenetrable — an accounting rule, a
        stablecoin's balance sheet, the volume of an amphora — and finding the
        one idea that makes it obvious.
      </p>
      <div class="facts">
        <p>Equity research associate. Previously a research assistant at Boston University's Department of Computer Science.</p>
        <p>MS Applied Data Analytics, Boston University. BS Mathematics &amp; Computer Science, Chennai Mathematical Institute. CFA Level&nbsp;1.</p>
        <p>Four peer-reviewed papers, including momentum strategies in <em>Stocks &amp; Commodities</em> and vase geometry in <em>MDPI Metrology</em>.</p>
        <p><a class="ln" href="/about">The longer version →</a></p>
      </div>
    </div>
  </section>

  <!-- 3 · what I talk about -->
  <section class="band rise">
    <h2 class="eyebrow">What I talk about</h2>
    <p class="lede">
      Every word below is marked up inside the writing itself. Size is how often
      I actually reach for an idea; colour and position are blended from the
      areas it turns up in. Click one to read everything on it.
    </p>
    <WordMap themes={themes} />
  </section>

  <!-- 4 · latest -->
  <section class="band rise">
    <h2 class="eyebrow">Recently</h2>
    <ul class="posts">
      {latest.map((p) => (
        <li>
          <a href={`/blog/${p.entry.id.replace(/\.(md|mdx)$/, "").toLowerCase()}/`}>
            <span class="pt">{p.entry.data.title}</span>
            <span class="pd">{p.entry.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
    <p><a class="ln" href="/blog">Everything I've written →</a></p>
  </section>

  <!-- 5 · contact + list -->
  <section class="band rise" id="contact">
    <h2 class="eyebrow">Get in touch</h2>
    <div class="two">
      <div>
        <p class="big">Say hello.</p>
        <p class="facts"><a class="ln" href={`mailto:${email}`}>{email}</a></p>
        <p class="facts">
          {presentation.socials.filter((s) => s.label !== "Email").map((s) => (
            <a class="ln sm" href={s.link} rel="me">{s.label}</a>
          ))}
        </p>
      </div>
      <Subscribe />
    </div>
  </section>
</Shell>

<style>
  .hero{
    min-height:100svh;display:flex;flex-direction:column;justify-content:center;
    padding:0 clamp(18px,6vw,80px);margin:0 auto;position:relative;isolation:isolate;
  }
  .hero-copy{position:relative;z-index:2;max-width:1180px;margin:0 auto;width:100%}
  .scrim{
    position:absolute;inset:0;z-index:1;pointer-events:none;
    background:linear-gradient(103deg,
      rgba(5,12,15,.90) 0%, rgba(5,12,15,.72) 26%,
      rgba(5,12,15,.34) 48%, transparent 66%);
  }
  @media(max-width:760px){
    .scrim{background:linear-gradient(180deg,
      rgba(5,12,15,.88) 0%, rgba(5,12,15,.66) 46%, rgba(5,12,15,.22) 72%, transparent 100%)}
  }
  .kicker{
    font-family:var(--sans);font-size:12px;letter-spacing:.24em;text-transform:uppercase;
    color:var(--text-3);margin:0 0 18px;
    animation:up .9s .05s cubic-bezier(.2,.7,.3,1) both;
  }
  .hero h1{
    font-size:clamp(52px,11.5vw,148px);line-height:.94;letter-spacing:-.045em;
    margin:0 0 clamp(22px,3.4vw,38px);
    background:linear-gradient(104deg,var(--glow) 0%,var(--peacock) 34%,var(--azure) 68%,var(--iris) 100%);
    background-size:200% 100%;
    -webkit-background-clip:text;background-clip:text;color:transparent;
    animation:up 1.05s .16s cubic-bezier(.2,.7,.3,1) both, hue 15s 1.4s ease-in-out infinite;
  }
  .hero .line{
    font-size:clamp(18px,2.2vw,26px);color:var(--text-2);max-width:34ch;margin:0;
    animation:up 1s .3s cubic-bezier(.2,.7,.3,1) both;
  }
  .hero .line em{font-style:italic;color:var(--text)}
  @keyframes up{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:none}}
  @keyframes hue{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}

  .scroll-cue{position:absolute;left:50%;bottom:38px;translate:-50% 0;
    width:1px;height:52px;background:linear-gradient(var(--text-3),transparent);overflow:hidden}
  .scroll-cue span{position:absolute;inset:0;background:var(--glow);animation:cue 2.6s ease-in-out infinite}
  @keyframes cue{0%{transform:translateY(-100%)}60%,100%{transform:translateY(100%)}}

  .band{max-width:1180px;margin:0 auto;padding:clamp(70px,11vw,140px) clamp(18px,6vw,80px) 0}
  .eyebrow{
    font-family:var(--sans);font-size:11.5px;letter-spacing:.22em;text-transform:uppercase;
    color:var(--text-3);margin:0 0 26px;font-weight:500;
  }
  .two{display:grid;gap:clamp(26px,4vw,64px)}
  @media(min-width:860px){.two{grid-template-columns:1.15fr .85fr;align-items:start}}
  .big{font-size:clamp(23px,3.1vw,38px);line-height:1.28;margin:0;color:var(--text)}
  .facts{color:var(--text-2);font-size:16px;margin:0 0 14px}
  .facts em{font-style:italic}
  .lede{color:var(--text-2);max-width:62ch;font-size:17px;margin:0 0 34px}

  .ln{
    font-family:var(--sans);font-size:14.5px;text-decoration:none;color:var(--glow);
    border-bottom:1px solid rgba(62,212,224,.28);padding-bottom:1px;transition:border-color .3s;
  }
  .ln:hover{border-bottom-color:var(--glow)}
  .ln.sm{margin-right:20px}

  .posts{list-style:none;margin:0 0 30px;padding:0;border-top:1px solid var(--rule)}
  .posts li{border-bottom:1px solid var(--rule)}
  .posts a{
    display:grid;gap:5px;padding:24px 0;text-decoration:none;
    transition:padding-left .4s cubic-bezier(.2,.7,.3,1);
  }
  .posts a:hover{padding-left:14px}
  .pt{font-size:clamp(19px,2.1vw,25px);color:var(--text);line-height:1.24}
  .pd{font-family:var(--sans);font-size:14px;color:var(--text-3);max-width:74ch;line-height:1.55}
  .posts a:hover .pt{color:var(--glow)}
</style>

---
import Shell from "@/layouts/Shell.astro";
import BreadcrumbSchema from "@/components/seo/BreadcrumbSchema.astro";
import Disclosure from "@/components/Disclosure.astro";
import PersonSchema from "@/components/seo/PersonSchema.astro";
import presentation from "@/data/presentation";
import { allPieces } from "@/utils/allPieces";

const pieces = await allPieces();
const research = pieces.filter((p) => p.kind === "research")
  .sort((a, b) => +b.entry.data.publishedAt - +a.entry.data.publishedAt);
const socials = presentation.socials.filter((s) => s.label !== "Email");

// counts shown on the cards, derived from the real sources so they cannot drift
const courses = (await import("@/content/education/courses.json")).default as unknown[];
const { ROLES } = await import("@/data/experience");
const courseCount = courses.length;
const experienceCount = ROLES.length;
---
<Shell title="About | Siddhant Shah"
  description="Siddhant Shah — equity research associate. Background, published research, and how to get in touch."
  canonical="/about/">
  <BreadcrumbSchema slot="head" items={[{ name: "Home", url: "/" }, { name: "About" }]} />
  <PersonSchema slot="head" />

  <div class="page">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">About</p>
      <h1 class="h1">I explain hard things about money.</h1>
      <p class="lede">
        Accounting rules, unit economics, valuation, derivatives — and what all
        of that looks like once it moves onchain. Plus whatever else I happen to
        be pulling apart: lap times, a fertility register, the software I spend
        all day inside. Not everything worth writing down is work.
      </p>
    </div>

    <div class="wrap wrap--narrow"><div class="prose about">
      <p>
        I'm an equity research associate. The day job is working out what a
        business is actually worth: reading the filings closely, building the
        model, and being honest about which assumptions are carrying the answer.
        The method is the constant — build the dataset before you have a view,
        name the mechanism you think explains it, then try hard to falsify it.
      </p>
      <p>
        This site is where I write about everything else.<Disclosure variant="mark" />
        What I'm building, what I'm reading, and what I haven't worked out yet.
      </p>
      <p>
        I came at this from the other side. Before markets it was Bayesian
        inference, ensemble methods and statistical modelling — a research
        assistantship in Boston University's Department of Computer Science,
        systematic strategies, portfolio construction. That is still the toolkit;
        the subject just changed. A fair amount of what goes here is side quests —
        things I'm learning in public, the method pointed at Formula&nbsp;1
        telemetry or an IVF register. That is the point of having my own site
        rather than only a byline.
      </p>

      <h2>The detail</h2>
      <p class="sub">
        The full version of each, rather than a wall of bullets here.
      </p>
    </div>
    </div>

    <div class="wrap wrap--narrow">
      <ul class="cards">
        <li>
          <a href="/about/experience/">
            <span class="ct">Experience</span>
            <span class="cd">Equity research, and before that systematic strategy work at Boston University.</span>
            <span class="cm">{experienceCount} roles →</span>
          </a>
        </li>
        <li>
          <a href="/about/education/">
            <span class="ct">Education</span>
            <span class="cd">Boston University, Chennai Mathematical Institute, CFA Level&nbsp;1, and the courses I took for fun.</span>
            <span class="cm">{courseCount} courses →</span>
          </a>
        </li>
        <li>
          <a href="/research/">
            <span class="ct">Research</span>
            <span class="cd">Peer-reviewed papers on trading strategies, statistical method and mathematical modelling.</span>
            <span class="cm">{research.length} papers →</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="wrap wrap--narrow"><div class="prose about">
      <h2>Teaching</h2>
      <p>
        For four years I taught maths and physics to students preparing for the
        International Junior Science Olympiad, and I have taught introductory
        options and financial mathematics at STEMS. Teaching is the fastest way I
        know to find out whether you actually understand something, and it is the
        part of all this I am most enthusiastic about.
      </p>

      <h2>Elsewhere</h2>
      <p class="links">
        <a href={`mailto:${presentation.mail}`}>{presentation.mail}</a>
        {socials.map((s) => <a href={s.link} rel="me">{s.label}</a>)}
        <a href="/Resume.pdf">Résumé</a>
      </p>
    </div>

    {/* Outside .prose on purpose: the disclosure is a panel, not body copy, so
        it takes the page's content width rather than the 68ch reading measure. */}
    <Disclosure />
    </div>
  </div>
</Shell>

<style>
  .about{ margin-top:clamp(10px,2vw,20px); }
  .about h2{ font-family:var(--sans);font-weight:500;letter-spacing:-.015em;
    font-size:clamp(15px,1.5vw,17px);text-transform:uppercase;
    letter-spacing:.14em;color:var(--text-3);margin-top:2.6em; }
  .about ul{ padding-left:1.1em; }
  .about li{ margin-top:.5em; }
  .sub{ color:var(--text-2);margin:0; }
  .cards{ list-style:none;margin:clamp(18px,2.6vw,28px) 0 0;padding:0;display:grid;gap:12px; }
  @media (min-width:820px){ .cards{ grid-template-columns:repeat(3,minmax(0,1fr)); } }
  .cards a{
    display:grid;gap:7px;height:100%;text-decoration:none;
    padding:clamp(18px,2.4vw,24px);border:1px solid var(--rule);border-radius:var(--r-md);
    background:var(--surface-1);
    transition:border-color .3s, background .3s, transform .3s cubic-bezier(.2,.7,.3,1);
  }
  .cards a:hover{
    border-color:color-mix(in srgb, var(--peacock) 55%, transparent);
    background:var(--surface-2);transform:translateY(-3px);
  }
  .ct{ font-size:clamp(18px,2vw,21px);line-height:1.2;color:var(--text); }
  .cards a:hover .ct{ color:var(--glow); }
  .cd{ font-family:var(--sans);font-size:clamp(13.5px,1.3vw,14.5px);color:var(--text-3);line-height:1.55; }
  .cm{ font-family:var(--sans);font-size:12px;letter-spacing:.09em;text-transform:uppercase;
       color:var(--peacock);margin-top:auto;padding-top:4px; }
  .links{ display:flex;flex-wrap:wrap;gap:10px clamp(16px,3vw,28px);font-family:var(--sans);font-size:15px; }
</style>

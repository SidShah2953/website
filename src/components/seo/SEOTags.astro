---
import { SEO } from "astro-seo";
import { SITE_URL } from "@/data/config";
import type { HeadTags } from "@/utils/types/HeadTags";
import presentation from "@/data/presentation";

type Props = HeadTags;

const { title, description, noindex, canonical, og } = Astro.props;

const DEFAULT_TITLE_PAGE = "Siddhant Shah";
const DEFAULT_DESCRIPTION_PAGE = presentation.description.replace(/\*/g, '');

// Build canonical URL
const canonicalUrl = canonical
  ? (canonical.startsWith('http') ? canonical : `${SITE_URL}${canonical}`)
  : `${SITE_URL}${Astro.url.pathname}`;

// Build OG image URL
const ogImage = og?.image
  ? (og.image.startsWith('http') ? og.image : `${SITE_URL}${og.image}`)
  : `${SITE_URL}/social-prev.png`;

const openGraph = {
  title: og?.title || title || "Hello! I'm Siddhant.",
  type: og?.type || "website",
  image: ogImage,
  alt: og?.alt || "Siddhant Shah",
  url: canonicalUrl,
  description: og?.description || description || DEFAULT_DESCRIPTION_PAGE,
};
---

<head>
  <SEO
    charset="UTF-8"
    title={title || DEFAULT_TITLE_PAGE}
    description={description || DEFAULT_DESCRIPTION_PAGE}
    noindex={noindex || false}
    canonical={canonicalUrl}
    openGraph={{
      basic: {
        title: openGraph.title,
        type: openGraph.type,
        image: openGraph.image,
        url: openGraph.url,
      },
      optional: {
        description: openGraph.description,
      },
      image: {
        alt: openGraph.alt,
      },
    }}
    twitter={{
      card: "summary_large_image",
      title: openGraph.title,
      description: openGraph.description,
      image: openGraph.image,
    }}
    extend={{
      link: [
        // SVG first for browsers that take it; a PNG fallback for those that
        // do not; .ico because crawlers request that path by name. iOS ignores
        // SVG for the home-screen icon, so apple-touch-icon must be a PNG.
        { rel: "icon", href: "/favicon.svg", type: "image/svg+xml" },
        { rel: "icon", href: "/favicon-32.png", sizes: "32x32", type: "image/png" },
        { rel: "icon", href: "/favicon-16.png", sizes: "16x16", type: "image/png" },
        { rel: "apple-touch-icon", href: "/apple-touch-icon.png", sizes: "180x180" },
        { rel: "manifest", href: "/site.webmanifest" },
        { rel: "sitemap", href: "/sitemap-index.xml" },
        // without this the feed is undiscoverable — no reader or browser can find it
        { rel: "alternate", type: "application/rss+xml",
          title: "Siddhant Shah — Writing", href: "/blog/rss.xml" },
      ],
      meta: [
        { name: "viewport", content: "width=device-width, initial-scale=1" },
        { name: "generator", content: Astro.generator },
        { name: "author", content: "Siddhant Shah" },
        // tints mobile browser chrome to the page ground, so the bar does
        // not sit as a bright strip above a dark page
        { name: "theme-color", content: "#050C0F" },
      ],
    }}
  />
</head>

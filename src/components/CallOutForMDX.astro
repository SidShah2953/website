---
type Props = { title: string };
const { title } = Astro.props;
---
<aside class="callout">
  <h4>{title}</h4>
  <div class="cb"><slot /></div>
</aside>

<style>
  .callout{
    margin:clamp(26px,3.4vw,38px) 0;padding:clamp(18px,2.4vw,26px);
    border:1px solid var(--rule);border-radius:var(--r-md);
    background:var(--surface-2);
    border-left:2px solid var(--peacock);
  }
  h4{
    margin:0 0 .5em;font-family:var(--sans);font-weight:500;
    font-size:clamp(14.5px,1.4vw,15.5px);letter-spacing:.02em;color:var(--text);
  }
  .cb{ color:var(--text-2);font-size:clamp(15.5px,1.1vw,16.5px);line-height:1.66; }
  .cb :global(> *:first-child){ margin-top:0; }
  .cb :global(> *:last-child){ margin-bottom:0; }
  .cb :global(a){ color:var(--glow);text-decoration:none;
    border-bottom:1px solid var(--glow-line); }
</style>

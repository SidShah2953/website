---
type Props = { href: string; title: string };
const { href, title } = Astro.props;
---
<a class="deep" href={href}>
  <span class="ic" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
      stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 3h8l4 4v14H6z" /><path d="M14 3v4h4" />
      <path d="M9 12h6" /><path d="M9 16h6" />
    </svg>
  </span>
  <span class="tx">
    <span class="lb">Deep dive</span>
    <span class="tt">{title}</span>
  </span>
  <span class="ar" aria-hidden="true">→</span>
</a>

<style>
  .deep{
    display:flex;align-items:center;gap:clamp(12px,1.6vw,16px);
    margin:clamp(22px,3vw,32px) 0;padding:clamp(13px,1.6vw,16px) clamp(15px,1.8vw,18px);
    border:1px solid var(--rule);border-radius:14px;text-decoration:none;
    background:rgba(255,255,255,.028);
    transition:border-color .3s, background .3s, transform .3s cubic-bezier(.2,.7,.3,1);
  }
  .deep:hover{
    border-color:color-mix(in srgb, var(--peacock) 60%, transparent);
    background:rgba(23,145,158,.09);transform:translateY(-2px);
  }
  .ic{
    flex:none;width:34px;height:34px;display:grid;place-items:center;border-radius:10px;
    border:1px solid color-mix(in srgb, var(--peacock) 40%, transparent);
    color:var(--glow);background:rgba(23,145,158,.10);
  }
  .ic svg{ width:17px;height:17px; }
  .tx{ display:grid;gap:3px;min-width:0; }
  .lb{
    font-family:var(--sans);font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;
    color:var(--text-3);
  }
  .tt{ font-family:var(--sans);font-size:clamp(14px,1.4vw,15px);color:var(--text);line-height:1.35; }
  .ar{ margin-left:auto;color:var(--text-3);font-size:16px;transition:color .3s,translate .3s; }
  .deep:hover .ar{ color:var(--glow);translate:3px 0; }
</style>

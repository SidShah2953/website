---
/**
 * Read-depth tracking, reported to GoatCounter as anonymous events.
 *
 * Pageviews measure arrival, not reading. This measures how far down the
 * article body a visitor actually got, and — more usefully — how many of them
 * plausibly *read* it rather than scrolling to the bottom in three seconds.
 *
 * Three kinds of event are sent, all keyed by pathname so they are per article
 * (helper and naming: src/scripts/track.ts):
 *
 *   depth-25|50|75|100<path>   the scroll funnel, each fired at most once
 *   read<path>                 a qualified read: reached >=90% of the body AND
 *                              stayed long enough to have read it
 *   time-15s|30s|1m|2m|5m|10m|20m<path>
 *                              engaged time, the clock running only while the
 *                              tab is visible and the reader has scrolled,
 *                              moved, touched or typed in the last 30 seconds.
 *                              A tab left open in the background does not count.
 *
 * The qualifying dwell is 35% of the estimated reading time. A 3,000-word piece
 * (~14 min at 220wpm) needs ~4:47 before it counts. That threshold is
 * deliberately forgiving of skimmers and re-readers while still excluding the
 * scroll-to-bottom-and-leave case, which is what makes a raw 100% figure
 * useless as evidence of attention.
 *
 * Measured against the article body, not the viewport, so the footer and
 * comments do not inflate depth. Cookieless and anonymous: no identifier is
 * created, read or sent, so this needs no consent banner.
 */
interface Props {
  /** Word count of the article body, used to derive the dwell threshold. */
  words: number;
  /** Selector for the element whose scroll extent defines 100%. */
  target?: string;
}
const { words, target = "#prose" } = Astro.props;
const WPM = 220;
const QUALIFY = 0.35;
// seconds of dwell before a completed scroll counts as a read
const dwellNeeded = Math.max(15, Math.round(((words / WPM) * 60) * QUALIFY));
---
<div data-readdepth data-target={target} data-dwell={dwellNeeded} hidden></div>

<script>
  import { track } from '@/scripts/track';

  const el = document.querySelector<HTMLElement>('[data-readdepth]');
  const body = el && document.querySelector<HTMLElement>(el.dataset.target || '#prose');

  if (el && body) {
    const dwellNeeded = Number(el.dataset.dwell) || 15;
    const start = Date.now();
    let deepest = 0;

    const measure = () => {
      const box = body.getBoundingClientRect();
      // How much of the body has scrolled past the bottom of the viewport,
      // as a fraction of the body's own height. Clamped, because a short
      // article is fully visible on load and would otherwise read as 100%
      // before anyone has done anything.
      const seen = Math.min(1, Math.max(0, (innerHeight - box.top) / Math.max(box.height, 1)));
      const pct = Math.round(seen * 100);
      if (pct > deepest) deepest = pct;

      for (const m of [25, 50, 75, 100]) if (deepest >= m) track(`depth-${m}`);

      if (deepest >= 90 && (Date.now() - start) / 1000 >= dwellNeeded) track('read');
    };

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; measure(); });
    };

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    // A reader who reaches the end and keeps reading crosses the dwell
    // threshold without scrolling again, so re-check when they leave.
    addEventListener('visibilitychange', () => { if (document.hidden) measure(); });
    addEventListener('pagehide', measure);
    measure();

    // Engaged time: one tick a second while the tab is visible and the
    // reader did something in the last 30 seconds. Reading is mostly still,
    // so 30s of grace covers a long paragraph without counting an idle tab.
    const MARKS: [number, string][] = [[15, '15s'], [30, '30s'], [60, '1m'], [120, '2m'], [300, '5m'], [600, '10m'], [1200, '20m']];
    let engaged = 0;
    let lastActive = Date.now();
    const active = () => { lastActive = Date.now(); };
    for (const ev of ['scroll', 'pointermove', 'pointerdown', 'keydown', 'touchstart', 'wheel']) {
      addEventListener(ev, active, { passive: true });
    }
    const timer = setInterval(() => {
      if (document.hidden || Date.now() - lastActive > 30000) return;
      engaged++;
      for (const [t, label] of MARKS) if (engaged === t) track(`time-${label}`);
      if (engaged >= MARKS[MARKS.length - 1][0]) clearInterval(timer);
    }, 1000);
  }
</script>

---
type Props = { href: string; filename: string };
const { href, filename } = Astro.props;
---
<a class="dl" href={href} download={filename}>
  <span class="ic" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
      stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3v12" /><path d="m7 11 5 5 5-5" /><path d="M4 20h16" />
    </svg>
  </span>
  <span class="tx">
    <span class="lb">Download</span>
    <span class="fn">{filename}</span>
  </span>
  <span class="ar" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
      stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v13" /><path d="m5 12 7 7 7-7" />
    </svg>
  </span>
</a>

<style>
  .dl{
    display:flex;align-items:center;gap:clamp(12px,1.6vw,16px);
    margin:clamp(22px,3vw,32px) 0;padding:clamp(13px,1.6vw,16px) clamp(15px,1.8vw,18px);
    border:1px solid var(--rule);border-radius:var(--r-md);text-decoration:none;
    background:var(--surface-1);
    transition:border-color .3s, background .3s, transform .3s cubic-bezier(.2,.7,.3,1);
  }
  .dl:hover{
    border-color:color-mix(in srgb, var(--peacock) 60%, transparent);
    background:var(--peacock-wash);transform:translateY(-2px);
  }
  .ic{
    flex:none;width:36px;height:36px;display:grid;place-items:center;border-radius:var(--r-sm);
    border:1px solid color-mix(in srgb, var(--peacock) 40%, transparent);
    color:var(--glow);background:var(--peacock-wash);
  }
  .ic svg{ width:20px;height:20px; }
  .tx{ display:grid;gap:3px;min-width:0; }
  .lb{
    font-family:var(--sans);font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;
    color:var(--text-3);
  }
  .fn{
    font-family:var(--sans);font-size:clamp(14px,1.4vw,15px);color:var(--text);
    overflow-wrap:anywhere;
  }
  .ar{ margin-left:auto;display:inline-flex;color:var(--text-3);transition:color .3s,translate .3s; }
  .dl:hover .ar{ color:var(--glow);translate:0 3px; }
</style>

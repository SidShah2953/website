---
/**
 * Raymarched iridescent surface — the hero's 3D element.
 *
 * Written as a raw WebGL2 fragment shader rather than three.js on purpose:
 * three.js is ~121 KB gz for what this does in ~4 KB, and the homepage is
 * currently 5 KB gz total. Everything here is genuinely 3D — a displaced
 * heightfield is ray-marched, surface normals are taken by finite differences,
 * and the shading is lit per-pixel.
 *
 * The colour is thin-film interference, which is the actual physics of a
 * peacock feather: the hue comes from light interfering across a film of
 * varying thickness, not from a pigment. So "metallic peacock" is literal here
 * rather than decorative, and the surface shifts hue with viewing angle the way
 * the real thing does.
 *
 * Degrades in three directions: no WebGL2 -> CSS gradient; reduced motion ->
 * one static frame; off-screen or hidden tab -> the loop stops entirely.
 */
---
<div class="surface" id="surface" aria-hidden="true">
  <canvas id="sfc"></canvas>
</div>

<style>
  .surface{
    position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none;
    /* fallback that shows if WebGL never initialises */
    background:
      radial-gradient(60% 50% at 22% 28%, rgba(23,145,158,.30), transparent 70%),
      radial-gradient(55% 45% at 78% 32%, rgba(47,111,232,.24), transparent 70%),
      radial-gradient(70% 55% at 50% 92%, rgba(106,90,216,.20), transparent 72%);
    /* no mask: the surface is the page's atmosphere now, not a hero band */
  }
  canvas{display:block;width:100%;height:100%;opacity:0;transition:opacity 1.2s ease}
  canvas.on{opacity:1}
</style>

<script>
const host = document.getElementById('surface') as HTMLElement | null;
const cv = document.getElementById('sfc') as HTMLCanvasElement | null;
const gl = cv?.getContext('webgl2', { antialias:false, alpha:true, powerPreference:'high-performance' });

if (host && cv && gl) {
  const VS = `#version 300 es
  in vec2 p; void main(){ gl_Position = vec4(p,0.,1.); }`;

  const FS = `#version 300 es
  precision highp float;
  uniform vec2  uRes;
  uniform float uTime;
  uniform vec2  uMouse;   // -1..1
  uniform float uScroll;  // 0..1 through the hero
  out vec4 outColor;

  const float PI = 3.14159265;

  float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7))) * 43758.5453); }
  float noise(vec2 p){
    vec2 i = floor(p), f = fract(p);
    vec2 u = f*f*(3.-2.*f);
    return mix(mix(hash(i), hash(i+vec2(1,0)), u.x),
               mix(hash(i+vec2(0,1)), hash(i+vec2(1,1)), u.x), u.y);
  }
  float fbm(vec2 p){
    float v = 0., a = .5;
    mat2 rot = mat2(.8,.6,-.6,.8);
    for(int i=0;i<3;i++){ v += a*noise(p); p = rot*p*1.94; a *= .46; }
    return v;
  }

  // height of the liquid surface at xz — two flows crossing at different speeds
  float height(vec2 q){
    float t = uTime*.045;
    float h  = fbm(q*.34 + vec2(t, t*.40));
    h += .40 * fbm(q*.72 - vec2(t*.62, t*.26));
    return (h - .62) * 0.95;          // visible swells, still liquid
  }

  // thin-film interference — the physics behind a peacock feather's colour
  vec3 filmColour(float cosT, float thickness){
    vec3 wl = vec3(680., 550., 440.);          // R,G,B wavelengths (nm)
    vec3 phase = (4.*PI*thickness*max(cosT,.001)) / wl;
    return .5 + .5*cos(phase);
  }

  void main(){
    vec2 uv = (gl_FragCoord.xy - .5*uRes) / uRes.y;

    // camera drifts with the pointer and sinks as the page scrolls
    // camera sinks toward the surface and levels off as the page scrolls
    float s = uScroll;
    vec3 ro = vec3(uMouse.x*.42 + s*0.7, 0.52 + s*1.45, 3.2 + uMouse.y*.22 - s*0.9);
    vec3 rd = normalize(vec3(uv, -1.15));
    rd.y -= 0.30 - s*0.16;             // horizon rises as you descend
    rd.y += uMouse.y*.05;
    rd = normalize(rd);

    // march down onto the heightfield
    float t = 0., hit = 0.;
    vec3 pos = ro;
    for(int i=0;i<58;i++){
      pos = ro + rd*t;
      float d = pos.y - height(pos.xz);
      if(d < .002){ hit = 1.; break; }
      t += max(d*.62, .022);
      if(t > 13.) break;
    }

    vec3 col = vec3(0.);
    if(hit > .5){
      // normal by finite differences
      vec2 e = vec2(.012, 0.);
      vec3 n = normalize(vec3(
        height(pos.xz - e.xy) - height(pos.xz + e.xy),
        2.*e.x,
        height(pos.xz - e.yx) - height(pos.xz + e.yx)));

      vec3 v = normalize(ro - pos);
      float fres = pow(1. - max(dot(n, v), 0.), 3.4);

      // film thickness varies over the surface, so hue travels across it
      // film thickness drifts with depth, so the hue travels down the page
      float thick = 300. + 240.*fbm(pos.xz*.85 + uTime*.03) + 130.*n.y + s*190.;
      vec3 film = filmColour(max(dot(n, v), 0.), thick);

      // pull the interference toward the peacock / azure / iris family
      vec3 peacock = vec3(.125,.557,.773);
      vec3 azure   = vec3(.184,.435,.910);
      vec3 iris    = vec3(.478,.392,.855);
      vec3 tint = mix(peacock, azure, smoothstep(.25,.85, film.b));
      tint = mix(tint, iris, smoothstep(.55,1., film.r) * .55);

      vec3 key = normalize(vec3(-.42, .78, .40));
      float diff = max(dot(n, key), 0.);
      float spec = pow(max(dot(reflect(-key, n), v), 0.), 64.);

      // the tint does the work; the film modulates it rather than whitening it
      // dark body: the surface is nearly black except where it catches light
      col  = tint * (.030 + .20*diff);

      // crests pick up the interference film; troughs stay dark
      float crest = smoothstep(-.05, .30, pos.y);
      col = mix(col, tint * film * 1.55, crest * .70);

      // grazing angles flare iridescent — this is the peacock effect
      col += tint * film * fres * 1.9;
      col += mix(tint, vec3(.70,.94,1.), .45) * spec * .30 * crest;

      col *= exp(-t*.22);                         // depth haze
    }

    // horizon glow so the surface dissolves rather than ending on a hard edge
    col += vec3(.035,.115,.145) * pow(max(1.-abs(uv.y*1.7),0.), 2.4) * .5;

    // fade out toward the top of the frame — the copy must stay legible
    float keepOut = smoothstep(0.10, -0.20, uv.y);
    col *= keepOut;
    col = 1.0 - exp(-col*1.35);                   // tone map
    col *= 0.92;
    col = pow(col, vec3(.4545));                  // gamma

    float a = clamp(max(max(col.r,col.g),col.b)*1.7, 0., 1.) * keepOut;
    outColor = vec4(col, a*.92);
  }`;

  const mk = (type:number, src:string) => {
    const s = gl.createShader(type)!;
    gl.shaderSource(s, src); gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
      console.error('[surface]', gl.getShaderInfoLog(s)); return null;
    }
    return s;
  };
  const vs = mk(gl.VERTEX_SHADER, VS), fs = mk(gl.FRAGMENT_SHADER, FS);

  if (vs && fs) {
    const prog = gl.createProgram()!;
    gl.attachShader(prog, vs); gl.attachShader(prog, fs); gl.linkProgram(prog);
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);

    const uRes = gl.getUniformLocation(prog,'uRes');
    const uTime = gl.getUniformLocation(prog,'uTime');
    const uMouse = gl.getUniformLocation(prog,'uMouse');
    const uScroll = gl.getUniformLocation(prog,'uScroll');

    // Raymarching is fill-rate bound. The old fixed 0.62 x capped-1.5 DPR meant
    // rendering ~22% of the pixels of a Retina surface and upscaling — which is
    // exactly what the visible pixelation was. Start at native and step down
    // only if the device actually cannot hold frame rate.
    const MAXDPR = 2;
    const TIERS = [1, 0.78, 0.6, 0.45];
    let tier = 0;
    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, MAXDPR) * TIERS[tier];
      const w = Math.max(1, Math.floor(host.clientWidth * dpr));
      const h = Math.max(1, Math.floor(host.clientHeight * dpr));
      if (cv.width !== w || cv.height !== h) { cv.width = w; cv.height = h; gl.viewport(0,0,w,h); }
    };
    resize();
    addEventListener('resize', resize, { passive:true });

    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const m = { x:0, y:0 }, target = { x:0, y:0 };
    addEventListener('pointermove', (e) => {
      target.x = (e.clientX / innerWidth) * 2 - 1;
      target.y = (e.clientY / innerHeight) * 2 - 1;
    }, { passive:true });

    let scroll = 0;
    const onScroll = () => {
      // progress through the entire page, not just the hero — the surface
      // travels with the reader rather than scrolling away behind them
      const max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
      scroll = Math.min(1, Math.max(0, scrollY / max));
    };
    onScroll();
    addEventListener('scroll', onScroll, { passive:true });

    let visible = true, raf = 0;
    // it is fixed and always on screen; only a hidden tab should stop the loop
    visible = true;
    document.addEventListener('visibilitychange', () => { if (!document.hidden) start(); });

    // rolling frame-cost measurement, so quality adapts instead of being guessed
    let last = 0, slow = 0, samples = 0;
    const t0 = performance.now();
    const frame = (now:number) => {
      raf = 0;
      if (!visible || document.hidden) return;           // stop entirely when unseen
      if (last) {
        const dt = now - last;
        if (samples++ > 12 && tier < TIERS.length - 1) {
          if (dt > 24) slow++; else slow = Math.max(0, slow - 1);
          if (slow > 20) { tier++; slow = 0; samples = 0; resize(); }
        }
      }
      last = now;
      resize();
      m.x += (target.x - m.x) * .045;
      m.y += (target.y - m.y) * .045;
      gl.uniform2f(uRes, cv.width, cv.height);
      gl.uniform1f(uTime, (now - t0) / 1000);
      gl.uniform2f(uMouse, m.x, m.y);
      gl.uniform1f(uScroll, scroll);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      if (!reduce.matches) start();
    };
    function start(){ if (!raf && visible && !document.hidden) raf = requestAnimationFrame(frame); }

    cv.classList.add('on');
    start();
  }
}
</script>

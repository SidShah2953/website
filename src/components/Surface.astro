---
/**
 * Raymarched iridescent surface — the hero's 3D element.
 *
 * Written as a raw WebGL2 fragment shader rather than three.js on purpose:
 * three.js is ~121 KB gz for what this does in ~4 KB, and the homepage is
 * currently 5 KB gz total. Everything here is genuinely 3D — a displaced
 * heightfield is ray-marched, surface normals are taken by finite differences,
 * and the shading is lit per-pixel.
 *
 * The colour is thin-film interference, which is the actual physics of a
 * peacock feather: the hue comes from light interfering across a film of
 * varying thickness, not from a pigment. So "metallic peacock" is literal here
 * rather than decorative, and the surface shifts hue with viewing angle the way
 * the real thing does.
 *
 * Degrades in three directions: no WebGL2 -> CSS gradient; reduced motion ->
 * one static frame; off-screen or hidden tab -> the loop stops entirely.
 */
---
<div class="surface" id="surface" aria-hidden="true">
  <canvas id="sfc"></canvas>
</div>

<style>
  .surface{
    position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none;
    /* Sized to the large viewport, not inset:0's current one. Otherwise every
       time a mobile address bar slides in or out the canvas is reallocated and
       the scene rescales mid-scroll, which reads as a jump or stretch. */
    bottom:auto;height:100vh;height:100lvh;
    /* fallback that shows if WebGL never initialises */
    background:
      radial-gradient(60% 50% at 22% 28%, rgba(23,145,158,.30), transparent 70%),
      radial-gradient(55% 45% at 78% 32%, rgba(47,111,232,.24), transparent 70%),
      radial-gradient(70% 55% at 50% 92%, rgba(106,90,216,.20), transparent 72%);
    /* no mask: the surface is the page's atmosphere now, not a hero band */
  }
  canvas{display:block;width:100%;height:100%;opacity:0;transition:opacity 1.2s ease}
  canvas.on{opacity:1}
</style>

<script>
const host = document.getElementById('surface') as HTMLElement | null;
const cv = document.getElementById('sfc') as HTMLCanvasElement | null;
const gl = cv?.getContext('webgl2', { antialias:false, alpha:true, premultipliedAlpha:true, powerPreference:'high-performance' });

if (host && cv && gl) {
  const VS = `#version 300 es
  in vec2 p; void main(){ gl_Position = vec4(p,0.,1.); }`;

  const FS = `#version 300 es
  precision highp float;
  uniform vec2  uRes;
  uniform float uTime;
  uniform vec2  uMouse;   // -1..1
  uniform float uScroll;  // 0..1 through the hero
  out vec4 outColor;

  const float PI = 3.14159265;

  // Not the usual fract(sin(dot(p,k))*43758.5) one-liner. That relies on sin()
  // staying accurate at arguments in the thousands, which only desktop GPUs do;
  // mobile GPUs range-reduce sin cheaply, so the "noise" collapses into blocks
  // and stripes, and every vendor draws a different pattern. This hash (Dave
  // Hoskins, "Hash without Sine") fract()s first, so every intermediate stays
  // small and the result is the same on every GPU.
  float hash(vec2 p){
    vec3 p3 = fract(vec3(p.xyx) * .1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
  }
  float noise(vec2 p){
    vec2 i = floor(p), f = fract(p);
    vec2 u = f*f*(3.-2.*f);
    return mix(mix(hash(i), hash(i+vec2(1,0)), u.x),
               mix(hash(i+vec2(0,1)), hash(i+vec2(1,1)), u.x), u.y);
  }
  float fbm(vec2 p){
    float v = 0., a = .5;
    mat2 rot = mat2(.8,.6,-.6,.8);
    for(int i=0;i<3;i++){ v += a*noise(p); p = rot*p*1.94; a *= .46; }
    return v;
  }

  // height of the liquid surface at xz — two flows crossing at different speeds
  float height(vec2 q){
    float t = uTime*.045;
    float h  = fbm(q*.34 + vec2(t, t*.40));
    h += .40 * fbm(q*.72 - vec2(t*.62, t*.26));
    return (h - .62) * 0.95;          // visible swells, still liquid
  }

  // thin-film interference — the physics behind a peacock feather's colour
  vec3 filmColour(float cosT, float thickness){
    vec3 wl = vec3(680., 550., 440.);          // R,G,B wavelengths (nm)
    vec3 phase = (4.*PI*thickness*max(cosT,.001)) / wl;
    return .5 + .5*cos(phase);
  }

  void main(){
    // Dividing by height alone fixes the vertical field of view, so the
    // horizontal one shrinks with the aspect ratio: a portrait phone saw a
    // quarter of the width a laptop does, zoomed into one blurred swell.
    // Below a 4:5 aspect, hold the horizontal view instead. Landscape is unchanged.
    vec2 uv = (gl_FragCoord.xy - .5*uRes) / min(uRes.y, uRes.x / .8);

    // keepOut (below) is exactly zero above this line, so the top of the frame
    // is always fully transparent. It used to be ray-marched and lit anyway and
    // then multiplied by zero: roughly 40% of the GPU work, thrown away.
    if (uv.y >= .10) { outColor = vec4(0.); return; }

    // camera drifts with the pointer and sinks as the page scrolls
    // camera sinks toward the surface and levels off as the page scrolls
    float s = uScroll;
    vec3 ro = vec3(uMouse.x*.42 + s*0.7, 0.52 + s*1.45, 3.2 + uMouse.y*.22 - s*0.9);
    vec3 rd = normalize(vec3(uv, -1.15));
    rd.y -= 0.30 - s*0.16;             // horizon rises as you descend
    rd.y += uMouse.y*.05;
    rd = normalize(rd);

    // march down onto the heightfield
    float t = 0., hit = 0.;
    vec3 pos = ro;
    // The heightfield never rises above HMAX (fbm tops out at .836, so
    // (1.4*.836 - .62)*.95 = .523). A ray above it pointing up can never hit.
    const float HMAX = .53;
    if (!(rd.y >= 0. && ro.y > HMAX))
    for(int i=0;i<58;i++){
      pos = ro + rd*t;
      float d = pos.y - height(pos.xz);
      if(d < .002){ hit = 1.; break; }
      t += max(d*.62, .022);
      if(t > 13.) break;
    }

    vec3 col = vec3(0.);
    if(hit > .5){
      // normal by finite differences
      vec2 e = vec2(.012, 0.);
      vec3 n = normalize(vec3(
        height(pos.xz - e.xy) - height(pos.xz + e.xy),
        2.*e.x,
        height(pos.xz - e.yx) - height(pos.xz + e.yx)));

      vec3 v = normalize(ro - pos);
      float fres = pow(1. - max(dot(n, v), 0.), 3.4);

      // film thickness varies over the surface, so hue travels across it
      // film thickness drifts with depth, so the hue travels down the page
      float thick = 300. + 240.*fbm(pos.xz*.85 + uTime*.03) + 130.*n.y + s*190.;
      vec3 film = filmColour(max(dot(n, v), 0.), thick);
      // Real thin films pass through gold and olive bands too. Keep the blue
      // channel from falling far below the others, so the hue stays in the
      // peacock-to-iris family by construction instead of depending on which
      // noise values the GPU happens to produce.
      film.b = max(film.b, .75 * max(film.r, film.g));

      // pull the interference toward the peacock / azure / iris family
      vec3 peacock = vec3(.125,.557,.773);
      vec3 azure   = vec3(.184,.435,.910);
      vec3 iris    = vec3(.478,.392,.855);
      vec3 tint = mix(peacock, azure, smoothstep(.25,.85, film.b));
      tint = mix(tint, iris, smoothstep(.55,1., film.r) * .55);

      vec3 key = normalize(vec3(-.42, .78, .40));
      float diff = max(dot(n, key), 0.);
      float spec = pow(max(dot(reflect(-key, n), v), 0.), 64.);

      // the tint does the work; the film modulates it rather than whitening it
      // dark body: the surface is nearly black except where it catches light
      col  = tint * (.030 + .20*diff);

      // crests pick up the interference film; troughs stay dark
      float crest = smoothstep(-.05, .30, pos.y);
      col = mix(col, tint * film * 1.55, crest * .70);

      // grazing angles flare iridescent — this is the peacock effect
      col += tint * film * fres * 1.9;
      col += mix(tint, vec3(.70,.94,1.), .45) * spec * .30 * crest;

      col *= exp(-t*.22);                         // depth haze
    }

    // horizon glow so the surface dissolves rather than ending on a hard edge
    col += vec3(.035,.115,.145) * pow(max(1.-abs(uv.y*1.7),0.), 2.4) * .5;

    // fade out toward the top of the frame — the copy must stay legible
    float keepOut = smoothstep(0.10, -0.20, uv.y);
    col *= keepOut;
    col = 1.0 - exp(-col*1.35);                   // tone map
    col *= 0.92;
    col = pow(col, vec3(.4545));                  // gamma

    // The canvas is premultiplied-alpha, so rgb must never exceed alpha. Writing
    // straight colour and blending it over the cleared buffer broke that wherever
    // keepOut < 1, and browsers disagree about what an invalid premultiplied
    // pixel looks like (overbright fringes in one, clamped in another).
    float a = clamp(max(max(col.r,col.g),col.b)*1.7, 0., 1.) * keepOut * .92;
    outColor = vec4(col * a, a);
  }`;

  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  // Quality is resolution: canvas pixels per CSS pixel. Tier 0 is the display's
  // native density (capped at 2x). The old ladder multiplied that by as little
  // as 0.45, which on a 1x laptop is 45% of the screen, and it only ever went
  // down: a 1366x768 laptop on battery ended up drawing 615x346 and stretching
  // it. Now the scale never drops below FLOOR CSS pixels, and it can climb back.
  const MAXDPR = 2, FLOOR = .75;
  const TIERS = [1, .8, .65, .5];
  let tier = 0;
  const scaleAt = (k:number) => Math.max(FLOOR, Math.min(devicePixelRatio || 1, MAXDPR) * TIERS[k]);

  // Everything that lives on the GPU. Mobile browsers drop WebGL contexts when
  // memory is tight or the tab is backgrounded; without rebuilding this the
  // canvas stays blank until a reload.
  let uRes:WebGLUniformLocation|null = null, uTime:WebGLUniformLocation|null = null,
      uMouse:WebGLUniformLocation|null = null, uScroll:WebGLUniformLocation|null = null;
  let ready = false;

  const mk = (type:number, src:string) => {
    const s = gl.createShader(type)!;
    gl.shaderSource(s, src); gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
      console.error('[surface]', gl.getShaderInfoLog(s)); return null;
    }
    return s;
  };
  const setup = () => {
    const vs = mk(gl.VERTEX_SHADER, VS), fs = mk(gl.FRAGMENT_SHADER, FS);
    if (!vs || !fs) return false;
    const prog = gl.createProgram()!;
    gl.attachShader(prog, vs); gl.attachShader(prog, fs); gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      console.error('[surface]', gl.getProgramInfoLog(prog)); return false;
    }
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    // Every pixel is written each frame with premultiplied output: no blending.
    gl.disable(gl.BLEND);

    uRes = gl.getUniformLocation(prog,'uRes');
    uTime = gl.getUniformLocation(prog,'uTime');
    uMouse = gl.getUniformLocation(prog,'uMouse');
    uScroll = gl.getUniformLocation(prog,'uScroll');
    gl.viewport(0, 0, cv.width, cv.height);
    return true;
  };

  const resize = () => {
    const k = scaleAt(tier);
    const w = Math.max(1, Math.round(host.clientWidth * k));
    const h = Math.max(1, Math.round(host.clientHeight * k));
    if (cv.width !== w || cv.height !== h) {
      cv.width = w; cv.height = h; gl.viewport(0,0,w,h);
      cv.dataset.res = `${w}x${h}`;           // inspectable on any device
      cv.dataset.tier = String(tier);
      return true;
    }
    return false;
  };

  const m = { x:0, y:0 }, target = { x:0, y:0 };
  addEventListener('pointermove', (e) => {
    target.x = (e.clientX / innerWidth) * 2 - 1;
    target.y = (e.clientY / innerHeight) * 2 - 1;
  }, { passive:true });

  let scroll = 0;
  const onScroll = () => {
    // progress through the entire page, not just the hero — the surface
    // travels with the reader rather than scrolling away behind them
    const max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
    scroll = Math.min(1, Math.max(0, scrollY / max));
  };
  onScroll();
  addEventListener('scroll', onScroll, { passive:true });

  // Frame-cost measurement, so quality adapts instead of being guessed.
  //
  // Two things the old version got wrong. It judged single frames against 24 ms,
  // and every 30 fps-capped browser fails that while idle: Chrome's Energy Saver
  // on battery, iOS Low Power Mode, Windows battery saver. And a burst of jank
  // from scrolling, page load or GC counted the same as a slow GPU.
  //
  // Now: take the median frame time over a window of WINDOW frames, and only
  // call it slow below 25 fps (a 30 fps cap reads ~33 ms and passes). After a
  // drop, wait, then probe one tier back up; if the probe is also slow, drop
  // again and stay there for the rest of the visit.
  const SLOW_MS = 40, WINDOW = 90, WARMUP = 30, PROBE_AFTER = 15000;
  let raf = 0, last = 0, frames = 0, probing = false, locked = false, probeAt = 0;
  const dts:number[] = [];
  const setTier = (k:number) => {
    tier = k; dts.length = 0;
    if (resize()) console.info('[surface] quality tier', tier, cv.dataset.res);
  };
  const judge = (now:number) => {
    const med = dts.sort((a, b) => a - b)[dts.length >> 1];
    dts.length = 0;
    if (med > SLOW_MS) {
      if (probing) locked = true;               // the higher tier failed twice
      probing = false;
      if (tier < TIERS.length - 1 && scaleAt(tier + 1) < scaleAt(tier)) {
        setTier(tier + 1); probeAt = now + PROBE_AFTER;
      }
    } else if (probing) {
      probing = false; probeAt = now + PROBE_AFTER;   // held: may try higher still
    } else if (tier > 0 && !locked && now > probeAt) {
      probing = true; setTier(tier - 1);
    }
  };
  const t0 = performance.now();

  const draw = (now:number) => {
    m.x += (target.x - m.x) * .045;
    m.y += (target.y - m.y) * .045;
    gl.uniform2f(uRes, cv.width, cv.height);
    gl.uniform1f(uTime, (now - t0) / 1000);
    gl.uniform2f(uMouse, m.x, m.y);
    gl.uniform1f(uScroll, scroll);
    gl.drawArrays(gl.TRIANGLES, 0, 3);
  };

  const frame = (now:number) => {
    raf = 0;
    if (!ready || document.hidden) { last = 0; return; }   // stop entirely when unseen
    if (last) {
      const dt = now - last;
      // ignore stalls (tab switch, a hidden-then-shown page): not GPU cost
      if (dt < 250 && ++frames > WARMUP) {
        dts.push(dt);
        if (dts.length >= WINDOW) judge(now);
      }
    }
    last = now;
    resize();
    draw(now);
    if (!reduce.matches) start();
  };
  function start(){ if (!raf && ready && !document.hidden) raf = requestAnimationFrame(frame); }

  // Resizing a canvas clears it. With reduced motion there is no loop to repaint
  // it, so the single static frame used to vanish on rotate or window resize.
  addEventListener('resize', () => { if (resize() && reduce.matches) start(); }, { passive:true });
  reduce.addEventListener?.('change', start);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) start(); });

  cv.addEventListener('webglcontextlost', (e) => {
    e.preventDefault();                     // tells the browser we will restore
    ready = false;
    if (raf) { cancelAnimationFrame(raf); raf = 0; }
    cv.classList.remove('on');              // fall back to the CSS gradient
  });
  cv.addEventListener('webglcontextrestored', () => {
    ready = setup();
    if (ready) { cv.classList.add('on'); last = 0; start(); }
  });

  resize();
  ready = setup();
  if (ready) { cv.classList.add('on'); start(); }
}
</script>

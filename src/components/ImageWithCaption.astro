---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
type Props = {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  class?: string;
  width?: number;
  height?: number;
};
const { src, alt, caption, class: className, ...rest } = Astro.props;
// An imported asset carries its own dimensions; a plain string src does not, so
// Astro requires them to be supplied or inferred.
const isImported = typeof src !== "string";
// Figures sit in the ~720px reading column but the sources are 1920-2970px
// wide, so every reader downloaded the full-size file. A srcset lets a phone
// take the 480px rendition and a retina laptop the 1440px one.
const WIDTHS = [480, 720, 1080, 1440];
const SIZES = "(min-width: 800px) 720px, calc(100vw - 32px)";
---
<figure class={`fig ${className ?? ""}`}>
  {isImported
    ? <Image src={src as ImageMetadata} alt={alt} widths={WIDTHS} sizes={SIZES} {...rest} />
    : <Image src={src as string} alt={alt} inferSize widths={WIDTHS} sizes={SIZES} {...rest} />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig{ margin:clamp(28px,4vw,44px) 0;display:grid;gap:12px; }
  .fig :global(img){
    width:100%;height:auto;display:block;border-radius:var(--r-md);
    border:1px solid var(--rule);
  }
  figcaption{
    font-family:var(--sans);font-size:clamp(12.5px,1.2vw,13.5px);line-height:1.55;
    color:var(--text-3);padding-left:14px;border-left:1px solid var(--rule);
  }
</style>

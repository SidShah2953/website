---
interface Props {
  /** Degree or award name, where the organisation alone isn't the headline. */
  title?: string;
  organization: string; organizationUrl?: string; subtitle?: string;
  dateRange: string; location?: string; items?: string[]; skills?: string;
}
const { title, organization, organizationUrl, subtitle, dateRange, location, items = [], skills } = Astro.props;
---
<li class="entry">
  <p class="when">{dateRange}{location ? ` · ${location}` : ""}</p>
  <h2 class="org">{title ?? organization}</h2>
  <p class="role">
    {title && (organizationUrl
      ? <a href={organizationUrl} rel="noopener">{organization}</a>
      : <span>{organization}</span>)}
    {title && subtitle ? " · " : ""}
    {subtitle}
  </p>
  {items.length > 0 && <ul class="pts">{items.map((i) => <li>{i}</li>)}</ul>}
  {skills && <p class="skills">{skills}</p>}
</li>

<style>
  .entry{ padding:clamp(22px,3vw,32px) 0;border-bottom:1px solid var(--rule);display:grid;gap:7px; }
  .when{ font-family:var(--sans);font-size:clamp(11.5px,1.1vw,12.5px);letter-spacing:.09em;
    text-transform:uppercase;color:var(--text-3);margin:0; }
  .org{ font-size:clamp(20px,2.6vw,27px);line-height:1.2;margin:0; }
  .org a{ text-decoration:none;transition:color .25s; }
  .org a:hover{ color:var(--glow); }
  .role{ font-family:var(--sans);font-size:clamp(14px,1.5vw,15.5px);color:var(--peacock);margin:0; }
  .pts{ margin:.5em 0 0;padding-left:1.05em;display:grid;gap:.5em; }
  .pts li{ color:var(--text-2);font-size:clamp(15.5px,1.1vw,16.5px);line-height:1.62; }
  .skills{ font-family:var(--sans);font-size:clamp(12.5px,1.2vw,13.5px);color:var(--text-3);
    margin:.4em 0 0;line-height:1.6; }
</style>

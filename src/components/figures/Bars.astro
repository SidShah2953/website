---
/**
 * A small horizontal bar chart in plain HTML, for a handful of values that
 * make one point. Every bar carries its value as text, so there is no axis to
 * read and nothing hidden behind a hover. Linear scale from zero, always:
 * the honest length is usually the point.
 *
 *   rows: [{ label, value, display?, accent? }]
 *   accent bars take the peacock gradient; the rest are muted.
 */
interface Row { label: string; value: number; display?: string; accent?: boolean; note?: string }
interface Props { title?: string; rows: Row[]; caption?: string; max?: number }
const { title, rows, caption } = Astro.props;
const max = Astro.props.max ?? Math.max(...rows.map((r) => r.value));
const fmt = (n: number) => n.toLocaleString("en-US");
---
<figure class="bars">
  <div class="box">
  {title && <p class="tag">{title}</p>}
  <div class="rows" role="table" aria-label={title}>
    {rows.map((r) => (
      <div class="row" role="row">
        <div class="label" role="rowheader">{r.label}{r.note && <span class="note"> {r.note}</span>}</div>
        <div class="track" role="cell">
          <span class="lane"><span class:list={["fill", { accent: r.accent }]} style={`width:${Math.max(0.6, (r.value / max) * 100)}%`}></span></span>
          <span class="val">{r.display ?? fmt(r.value)}</span>
        </div>
      </div>
    ))}
  </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .bars{
    margin:clamp(30px,4.5vw,48px) 0; display:grid; gap:12px;
  }
  .box{
    border:1px solid var(--rule); border-radius:var(--r-md); background:#08131A;
    padding:18px 20px 6px;
  }
  .rows{ display:grid; }
  .tag{
    margin:0 0 4px; font-family:var(--sans); font-size:11px; font-weight:500;
    letter-spacing:.16em; text-transform:uppercase; color:var(--text-3);
  }
  .row{ display:grid; grid-template-columns:minmax(150px,36%) 1fr; align-items:center; gap:6px 18px; padding:12px 0; border-bottom:1px solid var(--rule); }
  .row:last-child{ border-bottom:0; }
  .label{ font-family:var(--serif); font-size:16.5px; line-height:1.3; color:var(--text-2); }
  .note{ font-style:italic; color:var(--text-3); }
  .track{ display:grid; grid-template-columns:1fr auto; align-items:center; gap:14px; min-width:0; }
  .lane{ display:block; min-width:0; }
  .fill{
    display:block; height:10px; border-radius:2px 4px 4px 2px; min-width:4px;
    background:rgba(140,162,166,.45);
  }
  .fill.accent{ background:var(--peacock); }
  .val{
    font-family:var(--serif); font-size:17px; color:var(--text); white-space:nowrap;
    font-variant-numeric:lining-nums tabular-nums;
  }
  @media (max-width:560px){ .row{ grid-template-columns:1fr; } }
  figcaption{
    font-family:var(--sans); font-size:clamp(12.5px,1.2vw,13.5px); line-height:1.55;
    color:var(--text-3); padding-left:14px; border-left:1px solid var(--rule);
  }
</style>

---
/**
 * The seven Coinbase business lines around FY2025 revenue. Was a dark PNG,
 * which printed as a black slab on paper; rebuilt as HTML on the site tokens
 * so it restyles for the light print. Figures as in the original graphic.
 */
interface Card { n: string; area: string; name: string; value: string; lines: string[]; strong?: string; flag?: string; chip?: string }
const CARDS: Card[] = [
  { n: "01", area: "Retail exchange", name: "Consumer Trading", value: "$3.3B",
    strong: "46% of revenue, down from 90% in FY2021", lines: ["131bps take rate · 9.2M monthly transacting users"] },
  { n: "02", area: "Stablecoin", name: "USDC Distribution", value: "$1.35B",
    lines: ["100% on-platform · 50% off-platform"], strong: "$17.8B avg balance · 3.9% net yield", flag: "Contract renewal risk 2026" },
  { n: "03", area: "Institutional", name: "Instit. + Deribit", value: "$632M",
    strong: "$2.9B acquisition Aug 2025", lines: ["FY2026E $950M+"] },
  { n: "04", area: "Blockchain", name: "Base L2 Chain", value: "$60M net",
    lines: ["62% L2 fee market share · $4.63B DeFi TVL", "Departed OP Stack Feb 2026"], strong: "100% sequencer fee retention", chip: "10.7M txns/day" },
  { n: "05", area: "Staking", name: "ETH Staking", value: "$677M",
    strong: "29–35% commission · 2.7M ETH in custody", lines: ["Yield compressing 20–30bps/yr as staking participation exceeds 30%"], flag: "FY2026E: $250M vs $595M consensus" },
  { n: "06", area: "Infrastructure", name: "Coinbase Developer Platform", value: "The AWS moment",
    lines: ["Embedded in Other Transaction ($252.9M) & Other Sub & Services ($554.8M)", "270+ enterprise · 150+ govt clients"], strong: "JPMorgan, BlackRock, Stripe, Shopify" },
  { n: "07", area: "Subscriptions", name: "Coinbase One", value: "~$180M",
    strong: "~971K subscribers · All-time high", lines: ["3× growth in 3 years"] },
];
const { caption } = Astro.props as { caption?: string };
const card = (c: Card, cls = "") => ({ c, cls });
const grid = [card(CARDS[0], "a"), card(CARDS[1], "b"), card(CARDS[2], "c"), card(CARDS[3], "d"), null, card(CARDS[4], "e"), card(CARDS[5], "f"), card(CARDS[6], "g")];
---
<figure class="fly" aria-label="The seven layers of the Coinbase flywheel">
  <div class="grid">
    {grid.map((g) => g ? (
      <div class={`card ${g.cls}`}>
        <p class="tag">{g.c.n} · {g.c.area}</p>
        <p class="name">{g.c.name}</p>
        <p class="value">{g.c.value}</p>
        {g.c.strong && <p class="strong">{g.c.strong}</p>}
        {g.c.lines.map((l) => <p class="line">{l}</p>)}
        {g.c.chip && <p class="chip">{g.c.chip}</p>}
        {g.c.flag && <p class="flag">{g.c.flag}</p>}
      </div>
    ) : (
      <div class="card hub">
        <p class="hub-name">Coinbase</p>
        <p class="hub-value">$7.2B</p>
        <p class="tag">FY2025 revenue</p>
        <p class="hub-sub">Vertically integrated financial infrastructure</p>
      </div>
    ))}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fly{ margin:clamp(30px,4.5vw,48px) 0; display:grid; gap:12px; }
  .grid{ display:grid; gap:8px; grid-template-columns:repeat(6,minmax(0,1fr)); }
  .a{ grid-column:1 / 3; } .b{ grid-column:3 / 5; } .c{ grid-column:5 / 7; }
  .d{ grid-column:1 / 3; } .hub{ grid-column:3 / 5; } .e{ grid-column:5 / 7; }
  .f{ grid-column:1 / 3; } .g{ grid-column:3 / 5; }
  .card{
    background:var(--fig-panel); border:1px solid var(--fig-stroke); border-left:2px solid var(--peacock);
    border-radius:10px; padding:12px 13px 13px; display:flex; flex-direction:column; gap:3px; min-width:0;
  }
  .hub{
    background:var(--fig-panel-accent); border:1px solid var(--fig-accent-line); border-left-width:1px;
    align-items:center; justify-content:center; text-align:center; gap:2px; padding:18px 12px;
  }
  p{ margin:0; }
  .tag{ font-family:var(--sans); font-size:9.5px; font-weight:500; letter-spacing:.14em; text-transform:uppercase; color:var(--glow); }
  .name{ font-family:var(--serif); font-size:16px; line-height:1.2; color:var(--text); margin-top:2px; }
  .value{ font-family:var(--serif); font-size:22px; line-height:1.15; color:var(--glow); font-variant-numeric:lining-nums; margin:2px 0 3px; }
  .strong{ font-family:var(--sans); font-size:11px; line-height:1.4; color:var(--text); font-weight:500; }
  .line{ font-family:var(--sans); font-size:11px; line-height:1.4; color:var(--text-2); }
  .chip, .flag{
    align-self:flex-start; margin-top:5px; font-family:var(--sans); font-size:10px; line-height:1.3;
    padding:2px 7px; border-radius:var(--r-sm);
  }
  .chip{ color:var(--glow); border:1px solid var(--glow-line); }
  .flag{ color:var(--warn); border:1px solid var(--fig-friction); }
  .hub-name{ font-family:var(--serif); font-size:30px; line-height:1; color:var(--text); }
  .hub-value{ font-family:var(--serif); font-size:40px; line-height:1.1; margin:6px 0 2px; color:var(--glow); font-variant-numeric:lining-nums; }
  .hub-sub{ font-family:var(--sans); font-size:10px; letter-spacing:.12em; text-transform:uppercase; color:var(--text-3); margin-top:8px; }
  figcaption{
    font-family:var(--sans); font-size:clamp(12.5px,1.2vw,13.5px); line-height:1.55;
    color:var(--text-3); padding-left:14px; border-left:1px solid var(--rule);
  }
  @media (max-width:640px){
    .grid{ grid-template-columns:1fr 1fr; }
    .a,.b,.c,.d,.e,.f,.g{ grid-column:auto; }
    .hub{ grid-column:1 / -1; order:-1; }
  }
  @media (max-width:420px){ .grid{ grid-template-columns:1fr; } }
</style>

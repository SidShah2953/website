# Kit (formerly ConvertKit) form endpoint. Kit > Grow > Landing Pages & Forms >
# your form > Embed > HTML, and copy the form's action URL. It looks like:
#   https://app.kit.com/forms/<FORM_ID>/subscriptions
# Until this is set the subscribe form renders visibly disabled rather than
# silently dropping addresses.
PUBLIC_NEWSLETTER_ACTION=

# Kit API key, for drafting broadcasts on publish (Kit > Settings > Advanced >
# API). This one IS a secret: it can send email as you. In CI it belongs in
# repository *Secrets*, not Variables. Never prefix it with PUBLIC_ — that
# would inline it into the built HTML.
KIT_API_KEY=

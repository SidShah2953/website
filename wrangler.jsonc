{
  // analytics.siddhants.com: private readership dashboard. See README.md.
  "name": "siddhants-analytics",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "routes": [{ "pattern": "analytics.siddhants.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CF_ACCOUNT_ID": "5e5bf3007aa0b1e48b46ed066d0b4bc3",
    // Filled in once Cloudflare Access protects the hostname: the team name
    // (<team>.cloudflareaccess.com) and the application's Audience (AUD) tag.
    // Until both are set, /api refuses every request.
    "ACCESS_TEAM": "",
    "ACCESS_AUD": ""
  }
  // Secrets (wrangler secret put ...): GOATCOUNTER_TOKEN, KIT_API_KEY, CF_API_TOKEN
}
